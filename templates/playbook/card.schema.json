{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playbook card front matter (docs/PLAYBOOK.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "kind",
    "status",
    "job",
    "surface",
    "platform",
    "mechanism",
    "refuse",
    "evidence",
    "added_by",
    "created"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(interaction|flow|ai|visual|writing|listing|demand)-[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "domain": {
      "enum": [
        "interaction",
        "flow",
        "ai",
        "visual",
        "writing",
        "listing",
        "demand"
      ]
    },
    "kind": {
      "enum": [
        "pattern",
        "hook"
      ]
    },
    "status": {
      "enum": [
        "seen",
        "candidate",
        "trial",
        "adopted",
        "rejected",
        "inconclusive",
        "parked",
        "expired"
      ]
    },
    "job": {
      "type": "string",
      "minLength": 1,
      "maxWords": 8
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "ios",
        "android",
        "web",
        "mac",
        "any"
      ]
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "refuse": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "url",
          "seen",
          "what",
          "observed"
        ],
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          },
          "seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "enum": [
              true,
              "unknown"
            ]
          },
          "media": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "added_by": {
      "enum": [
        "owner",
        "claude",
        "codex",
        "grok"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxWords": 20
    },
    "format": {
      "enum": [
        "x-post",
        "x-thread",
        "reel-7s",
        "reel-15s",
        "carousel",
        "store-shot",
        "landing-hero"
      ]
    },
    "promise": {
      "type": "string",
      "minLength": 1
    },
    "proof": {
      "type": "string",
      "minLength": 1
    },
    "cta": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "text",
        "pointer"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "metric",
        "baseline",
        "threshold",
        "direction",
        "window_days",
        "guardrails",
        "review_by",
        "variants",
        "approved"
      ],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": [
            "string",
            "number"
          ]
        },
        "threshold": {
          "type": [
            "string",
            "number"
          ]
        },
        "direction": {
          "enum": [
            "up",
            "down"
          ]
        },
        "window_days": {
          "type": "integer",
          "minimum": 1
        },
        "guardrails": {
          "type": "string",
          "minLength": 1
        },
        "review_by": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "numbers",
        "date"
      ],
      "properties": {
        "result": {
          "enum": [
            "adopted",
            "rejected",
            "inconclusive",
            "parked"
          ]
        },
        "numbers": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "pr": {
          "type": [
            "string",
            "null"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "channel",
          "growth_item",
          "denominator"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "growth_item": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "integer",
            "minimum": 0
          },
          "views": {
            "type": "integer",
            "minimum": 0
          },
          "saves": {
            "type": "integer",
            "minimum": 0
          },
          "named_replies": {
            "type": "integer",
            "minimum": 0
          },
          "visits": {
            "type": "integer",
            "minimum": 0
          },
          "installs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "seen"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "problem": false,
          "severity": false,
          "confidence": false,
          "trial": false,
          "verdict": false,
          "results": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "expired"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "trial": false,
          "verdict": false,
          "results": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "candidate"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "problem",
          "severity",
          "confidence"
        ],
        "properties": {
          "trial": false,
          "verdict": false,
          "results": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "trial"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "problem",
          "severity",
          "confidence",
          "trial"
        ],
        "properties": {
          "verdict": false,
          "results": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "adopted",
              "rejected",
              "inconclusive",
              "parked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "verdict"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "hook"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "line",
          "format",
          "promise",
          "proof",
          "cta"
        ]
      },
      "else": {
        "properties": {
          "line": false,
          "format": false,
          "promise": false,
          "proof": false,
          "cta": false,
          "results": false
        }
      }
    }
  ],
  "$comment": "maxWords is a Teyla extension. Stage rules: a later stage's fields are refused on an earlier card."
}
