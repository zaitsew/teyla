# Rendered into /srv/{{name}}/.env (mode 600) on the shared server, then filled in there.
# Names only — a value never belongs in a file that is committed.
#
# Every name listed here should also appear in the repo's own .env.example and in
# `secrets = [...]` in teyla.toml, which is what `teyla productize` checks.

PORT={{port}}
# DATABASE_URL=
# OPENAI_API_KEY=
