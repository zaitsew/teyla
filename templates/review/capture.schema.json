{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zaitsew/teyla/templates/review/capture.schema.json",
  "title": "Teyla review capture, format v1",
  "description": "capture.json, written by the TeylaReview package next to capture.png and capture.sig (docs/REVIEW.md). A key that is absent means the value is unknown; null is never written.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "created", "device", "app", "environment", "anchors", "comment", "screenshot", "microphone"],
  "properties": {
    "v": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "device": {"type": "string", "pattern": "^[A-Za-z0-9 ._-]{1,64}$"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "version", "build", "configuration"],
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "name": {"type": "string", "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "build": {"type": "string", "minLength": 1, "maxLength": 64},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "configuration": {"enum": ["debug", "testflight", "local"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "model", "locale", "appearance", "dynamic_type", "screen"],
      "properties": {
        "os": {"type": "string", "minLength": 1, "maxLength": 64},
        "model": {"type": "string", "minLength": 1, "maxLength": 64},
        "locale": {"type": "string", "minLength": 1, "maxLength": 64},
        "language": {"type": "string", "minLength": 2, "maxLength": 16},
        "appearance": {"enum": ["light", "dark"]},
        "dynamic_type": {"enum": ["xSmall", "small", "medium", "large", "xLarge", "xxLarge", "xxxLarge", "accessibilityMedium", "accessibilityLarge", "accessibilityXLarge", "accessibilityXXLarge", "accessibilityXXXLarge", "unspecified"]},
        "screen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "scale"],
          "properties": {
            "width": {"type": "number", "minimum": 1},
            "height": {"type": "number", "minimum": 1},
            "scale": {"type": "number", "minimum": 1}
          }
        }
      }
    },
    "screen": {"type": "string", "pattern": "^[A-Za-z0-9_.:#/-]{1,200}$"},
    "tap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "accessibility_identifier": {"type": "string", "maxLength": 500},
        "accessibility_label": {"type": "string", "maxLength": 500}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "matched_by"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "matched_by": {"enum": ["anchor", "accessibility_identifier"]},
        "screen": {"type": "string", "maxLength": 200},
        "parent": {"type": "string", "maxLength": 200},
        "role": {"$ref": "#/$defs/role"},
        "bounds": {"$ref": "#/$defs/rect"},
        "strings": {"$ref": "#/$defs/strings"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "anchors": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/anchor"}},
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "input"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "input": {"enum": ["text", "speech"]},
        "language": {"type": "string", "minLength": 2, "maxLength": 16}
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "width", "height", "scale", "sha256"],
      "properties": {
        "file": {"const": "capture.png"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "scale": {"type": "number", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "microphone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_audio_in_use"],
      "properties": {
        "host_audio_in_use": {"type": "boolean"},
        "category": {"type": "string", "maxLength": 200}
      }
    }
  },
  "$defs": {
    "role": {"enum": ["button", "text", "field", "image", "list", "cell", "toggle", "container", "other"]},
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0}
      }
    },
    "strings": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "maxLength": 300},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "bounds"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "screen": {"type": "string", "maxLength": 200},
        "parent": {"type": "string", "maxLength": 200},
        "role": {"$ref": "#/$defs/role"},
        "bounds": {"$ref": "#/$defs/rect"},
        "strings": {"$ref": "#/$defs/strings"},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
