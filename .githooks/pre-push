#!/usr/bin/env bash
# Refuse a push that would put private data or non-English text on the public remote, or that
# carries code or documents the tests reject (POLICY section 10: ./check.sh is the gate, enforced here).
# Enable once per clone: git config core.hooksPath .githooks
# stdin, one line per ref: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
py=python3
[ -x .venv/bin/python ] && py=.venv/bin/python
zero=0000000000000000000000000000000000000000
fail=0
touched=0
docs=0
"$py" scripts/leak_check.py || fail=1
url="${2:-${1:-origin}}"
# What the destination already holds is asked of the destination itself (its push URL may
# differ from what local tracking refs mirror). Only commits it lacks are scanned; if it
# cannot be asked, the whole history being pushed is.
have=""
if remote_refs="$(git ls-remote "$url" 2>/dev/null)"; then
  for sha in $(printf '%s\n' "$remote_refs" | awk '{print $1}' | sort -u); do
    git cat-file -e "$sha^{commit}" 2>/dev/null && have="$have $sha"
  done
fi
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                      # deleting a ref
  if [ -n "$have" ]; then
    range="$lsha --not$have"                              # what the destination lacks
  else
    range="$lsha"                                         # empty or unreachable destination: all history
  fi
  "$py" scripts/leak_check.py --commits "$range" </dev/null || fail=1
  # What does the pushed range change? ($range is shas and --not only.) A document is a top-level
  # Markdown file or anything under docs/. Every other path is code for this gate: src, tests, apps,
  # plugin, templates, a lock file. Tests read those, so the full suite runs.
  # -m --first-parent makes a merge commit list the files it changes against its first parent:
  # plain `git log --name-only` prints none for a merge, so main merged into a feature branch
  # (the merge being the only new commit) used to skip the tests.
  # shellcheck disable=SC2086
  files="$(git log -m --first-parent --name-only --pretty=format: $range 2>/dev/null || true)"
  # Here-strings, not pipes: under pipefail a writer cut off by grep -q would read as "no match".
  if grep -qvE '^$|^[^/]+\.md$|^docs/' <<<"$files"; then touched=1
  elif grep -qE '^[^/]+\.md$|^docs/' <<<"$files"; then docs=1; fi
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push: leak check failed; fix the findings above (private terms: CONTRIBUTING.md)" >&2
  exit 1
fi
# Tests run only when the leak check passed (a failed push should not cost eleven minutes).
# Code runs the whole of ./check.sh. A push of documents alone runs `./check.sh docs`: the tests that
# read a tracked document (the README's commands and pictures, AGENTS.md, the privacy table).
# TEYLA_PREPUSH_TESTS=0 skips either for one push; the skip is logged, and a skip that cannot
# be logged is refused.
mode=none
if [ "$touched" -eq 1 ]; then mode=full; elif [ "$docs" -eq 1 ]; then mode=docs; fi
if [ "$mode" != none ] && [ -x ./check.sh ]; then
  if [ "${TEYLA_PREPUSH_TESTS:-1}" = "0" ]; then
    home="${TEYLA_HOME:-$HOME/.teyla}"
    { mkdir -p "$home" && printf '%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$(basename "$root")" \
        >> "$home/prepush-skips.log"; } || {
      echo "pre-push: cannot record the skip in $home/prepush-skips.log; a skip that is not on record is not a skip" >&2
      exit 1
    }
    echo "pre-push: tests skipped (TEYLA_PREPUSH_TESTS=0), logged in $home/prepush-skips.log" >&2
  elif [ "$mode" = docs ]; then
    # About 80 seconds of tests and no build: it does not queue for a build slot.
    echo "pre-push: only documents changed; running ./check.sh docs (TEYLA_PREPUSH_TESTS=0 skips it, logged)" >&2
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX ./check.sh docs </dev/null >&2 || {
      echo "pre-push: ./check.sh docs failed; a document no longer matches what the tests pin" >&2
      exit 1
    }
  else
    # The full suite is Python tests, not an Xcode or Gradle build: wait for a lane slot, not one of the build slots.
    # 2026-11-23: three pushes of one branch timed out behind 7 queued builds. A missing teyla runs it at once.
    if command -v teyla >/dev/null 2>&1; then teyla load --wait --kind lane </dev/null >&2 || exit 1; fi
    echo "pre-push: running ./check.sh (TEYLA_PREPUSH_TESTS=0 skips it, logged)" >&2
    # git's own variables must not leak into the tests' scratch repositories
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX ./check.sh </dev/null >&2 || {
      echo "pre-push: ./check.sh failed; fix the failures above before pushing" >&2
      exit 1
    }
  fi
fi
